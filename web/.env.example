# Geleceğin Tarımı server settings for the AI explanations (/api/explain).
#
# HOW TO USE
#   1. Copy this file to web/.env.local  (that file is gitignored and never committed)
#   2. Put your real key in web/.env.local, not here
#   3. Restart the dev server:  npm --prefix web run dev
#
# These are read only on the server (dev server or serverless function). None has
# a VITE_ prefix, so Vite never puts them in the browser bundle.
# When you deploy (Vercel/Netlify), add the same names in the host's
# "Environment Variables" settings instead of uploading this file.

# Google Gemini (free tier: create a key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: which Gemini model. Default gemini-3.5-flash-lite (stable, cheapest,
# larger free daily quota). For better wording on a paid key: gemini-3.8-flash
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: Anthropic Claude instead of Gemini
ANTHROPIC_API_KEY=

# Optional: force one provider when both keys are set (gemini or claude).
# Empty = Gemini if GEMINI_API_KEY is set, otherwise Claude.
AI_PROVIDER=
